{
  "name": "@yrols/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "email:cloud": "tsx src/emailCloud.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "imapflow": "^1.7.8",
    "mailparser": "^3.7.2",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
