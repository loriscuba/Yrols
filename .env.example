# Porta del server
PORT=3001
# Percorso del database SQLite
YROLS_DB=./data/yrols.db
# Token condiviso con il connettore Enable Banking (POST /api/banks/sync)
YROLS_INGEST_TOKEN=cambia-questo-token
# Protezione del cruscotto con HTTP Basic (consigliata se esposto in rete)
YROLS_USER=
YROLS_PASSWORD=

# Importazione bollette/scadenze dalla posta (IMAP).
# Gmail: imap.gmail.com, porta 993, utente = indirizzo, password = "password per le app"
# (richiede la verifica in due passaggi: https://myaccount.google.com/apppasswords)
YROLS_IMAP_HOST=
YROLS_IMAP_PORT=993
YROLS_IMAP_USER=
YROLS_IMAP_PASSWORD=
YROLS_IMAP_MAILBOX=INBOX
YROLS_IMAP_SINCE_DAYS=60
# Scansione automatica ogni N minuti (0 = solo manuale dal cruscotto)
YROLS_IMAP_INTERVAL_MIN=60
