# Application ID dell'app registrata su https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# Percorso della chiave privata RSA (.pem) scaricata alla creazione dell'app
ENABLE_BANKING_PRIVATE_KEY_PATH=./keys/enable-banking.pem
# In alternativa: chiave privata inline (con \n al posto degli a capo)
# ENABLE_BANKING_PRIVATE_KEY=
# Redirect URL registrata nell'app Enable Banking: deve essere https e puntare a /api/banks/callback
ENABLE_BANKING_REDIRECT_URL=https://localhost:8787/api/banks/callback
# Endpoint API (default produzione; la sandbox usa lo stesso host con app di tipo sandbox)
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
# Durata del consenso richiesto alla banca, in giorni (max tipico PSD2: 180)
ENABLE_BANKING_CONSENT_DAYS=90

# Server del connettore
PORT=8787
# Certificato per servire https in locale (generalo con: npm run cert)
TLS_CERT_PATH=./keys/localhost-cert.pem
TLS_KEY_PATH=./keys/localhost-key.pem
DATA_FILE=./data/enable-banking.json
# Token richiesto in Authorization: Bearer <token> per le API (fortemente consigliato)
CONNECTOR_API_TOKEN=
# Origine del cruscotto web autorizzata via CORS
CORS_ORIGIN=http://localhost:3000
# Dove rimandare l'utente dopo il consenso bancario
DASHBOARD_URL=http://localhost:3000/banche

# Push verso il cruscotto Yrols (POST {YROLS_URL}/api/banks/sync)
YROLS_URL=http://localhost:4000
YROLS_INGEST_TOKEN=
# Sincronizzazione automatica in minuti (0 = disattivata)
SYNC_INTERVAL_MINUTES=360
